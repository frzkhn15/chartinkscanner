def create_empty_dataframe():
    return pd.DataFrame(columns=[
        'open','high','low','close','volume','ema9','bb_upper','bb_middle','bb_lower'
    ])

def ensure_indicators(df):
    """
    Given a DataFrame with columns ['open','high','low','close','volume'], 
    calculate ema9, bb_upper, bb_middle, bb_lower locally and return the DataFrame.
    """
    if df.empty:
        return df
    df = df.copy()
    df['ema9'] = df['close'].ewm(span=STRATEGY_PARAMS['ema_period'], adjust=False).mean()
    period = STRATEGY_PARAMS['bb_period']
    std_dev = STRATEGY_PARAMS['bb_std_dev']
    rolling_mean = df['close'].rolling(window=period).mean()
    rolling_std = df['close'].rolling(window=period).std()
    df['bb_upper'] = rolling_mean + (rolling_std * std_dev)
    df['bb_middle'] = rolling_mean
    df['bb_lower'] = rolling_mean - (rolling_std * std_dev)
    logger.debug("Calculated EMA9 and Bollinger Bands locally.")
    return df

def fetch_historical_data_chartink(chartink_symbol, period_days=2):
    """
    Replace the mock generator with a real call to ChartinkAPI.fetch_data.
    That returns a list of dicts; convert to DataFrame and calculate indicators.
    """
    global chartink_api
    try:
        logger.info(f"Fetching historical data for {chartink_symbol} from Chartink.")
        if chartink_api is None:
            chartink_api = ChartinkAPI()
        
        # We request size=500 to get ~500 candles (5-minute) → ~500*5min ≈ ~41 hours of history.
