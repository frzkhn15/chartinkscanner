        logger.error(f"Error in fetch_historical_data_chartink: {e}")
        return create_empty_dataframe()

def calculate_support_resistance(df, lookback=20, min_touches=2):
    """
    Identify support and resistance levels from historical data.
    Returns dict with support/resistance levels and their strength.
    """
    if len(df) < lookback * 2:
        return {'support_levels': [], 'resistance_levels': []}
    
    # Get recent highs and lows
    highs = df['high'].rolling(window=lookback, center=True).max()
    lows = df['low'].rolling(window=lookback, center=True).min()
    
    # Find pivot points
    pivot_highs = []
    pivot_lows = []
    
    for i in range(lookback, len(df) - lookback):
        if df['high'].iloc[i] == highs.iloc[i]:
            pivot_highs.append((i, df['high'].iloc[i]))
        if df['low'].iloc[i] == lows.iloc[i]:
            pivot_lows.append((i, df['low'].iloc[i]))
    
    # Group similar levels (within 0.5% of each other)
    def group_levels(levels, tolerance=0.005):
        if not levels:
            return []
        
        grouped = []
        levels.sort(key=lambda x: x[1])  # Sort by price
        
        current_group = [levels[0]]
        
        for level in levels[1:]:
            if abs(level[1] - current_group[-1][1]) / current_group[-1][1] <= tolerance:
                current_group.append(level)
            else:
                if len(current_group) >= min_touches:
                    avg_price = sum(l[1] for l in current_group) / len(current_group)
                    grouped.append({
                        'price': avg_price,
                        'touches': len(current_group),
                        'strength': len(current_group) * 10  # Simple strength calculation
                    })
                current_group = [level]
        
        # Don't forget the last group
        if len(current_group) >= min_touches:
            avg_price = sum(l[1] for l in current_group) / len(current_group)
            grouped.append({
                'price': avg_price,
                'touches': len(current_group),
                'strength': len(current_group) * 10
            })
        
        return grouped
    
    support_levels = group_levels(pivot_lows)
    resistance_levels = group_levels(pivot_highs)
    
    # Sort by strength (strongest first)
    support_levels.sort(key=lambda x: x['strength'], reverse=True)
    resistance_levels.sort(key=lambda x: x['strength'], reverse=True)
    
    return {
        'support_levels': support_levels[:5],  # Top 5 support levels
        'resistance_levels': resistance_levels[:5]  # Top 5 resistance levels
    }

def generate_trade_signal_with_sr(df, current_position=None):
    """
    Enhanced signal generation incorporating support/resistance levels.
    """
    if len(df) < 2:
        return "NEUTRAL", {}
    
    # Get current price and previous price
    curr_close = df['close'].iloc[-1]
    prev_close = df['close'].iloc[-2]
    
    # Calculate S/R levels
    sr_data = calculate_support_resistance(df)
    support_levels = sr_data['support_levels']
    resistance_levels = sr_data['resistance_levels']
    
    # Original EMA/BB signals
    curr_ema9 = df['ema9'].iloc[-1]
    prev_ema9 = df['ema9'].iloc[-2]
    curr_bb_middle = df['bb_middle'].iloc[-1]
    prev_bb_middle = df['bb_middle'].iloc[-2]
    
    if pd.isna(curr_ema9) or pd.isna(prev_ema9) or pd.isna(curr_bb_middle) or pd.isna(prev_bb_middle):
        return "NEUTRAL", {'support_levels': support_levels, 'resistance_levels': resistance_levels}
    
    # S/R analysis
    signal_strength = 0
    signal_type = "NEUTRAL"
    signal_reason = []
    
    # Check proximity to support/resistance (within 0.2%)
    tolerance = 0.002
    
    # Find nearest support and resistance
    nearest_support = None
    nearest_resistance = None
    
    for support in support_levels:
        if abs(curr_close - support['price']) / curr_close <= tolerance:
            nearest_support = support
            break
    
    for resistance in resistance_levels:
        if abs(curr_close - resistance['price']) / curr_close <= tolerance:
            nearest_resistance = resistance
            break
    
    # Support level bounce (BUY signal)
    if nearest_support:
        if prev_close < nearest_support['price'] and curr_close >= nearest_support['price']:
            signal_type = "BUY"
            signal_strength += nearest_support['strength']
            signal_reason.append(f"Support bounce at {nearest_support['price']:.2f}")
    
    # Resistance level rejection (SELL signal)
    if nearest_resistance:
        if prev_close > nearest_resistance['price'] and curr_close <= nearest_resistance['price']:
            signal_type = "SELL"
            signal_strength += nearest_resistance['strength']
            signal_reason.append(f"Resistance rejection at {nearest_resistance['price']:.2f}")
    
    # Breakout signals
    breakout_tolerance = 0.001  # 0.1% beyond S/R level
    
    # Resistance breakout (strong BUY)
    for resistance in resistance_levels[:2]:  # Check top 2 resistance levels
        if (prev_close <= resistance['price'] and 
            curr_close > resistance['price'] * (1 + breakout_tolerance)):
            signal_type = "BUY"
            signal_strength += resistance['strength'] * 1.5  # Breakouts get higher weight
            signal_reason.append(f"Resistance breakout above {resistance['price']:.2f}")
            break
    
    # Support breakdown (strong SELL)
    for support in support_levels[:2]:  # Check top 2 support levels
        if (prev_close >= support['price'] and 
            curr_close < support['price'] * (1 - breakout_tolerance)):
            signal_type = "SELL"
            signal_strength += support['strength'] * 1.5
            signal_reason.append(f"Support breakdown below {support['price']:.2f}")
            break
    
    # Combine with EMA/BB signals for confirmation
    cross_above_ema = (prev_close <= prev_ema9) and (curr_close > curr_ema9)
    cross_below_ema = (prev_close >= prev_ema9) and (curr_close < curr_ema9)
    above_bb_middle = curr_close >= curr_bb_middle
    below_bb_middle = curr_close <= curr_bb_middle
    
    # EMA/BB confirmation
    if signal_type == "BUY" and cross_above_ema and above_bb_middle:
        signal_strength += 20
        signal_reason.append("EMA/BB confirmation")
    elif signal_type == "SELL" and cross_below_ema and below_bb_middle:
        signal_strength += 20
        signal_reason.append("EMA/BB confirmation")
    elif signal_type == "NEUTRAL":
        # Original EMA/BB signals if no S/R signals
        if cross_above_ema and above_bb_middle:
            signal_type = "BUY"
            signal_strength = 15
            signal_reason.append("EMA/BB bullish crossover")
        elif cross_below_ema and below_bb_middle:
            signal_type = "SELL"
            signal_strength = 15
            signal_reason.append("EMA/BB bearish crossover")
    
    # Minimum signal strength threshold
    if signal_strength < 10:
        signal_type = "NEUTRAL"
    
    return signal_type, {
        'support_levels': support_levels,
        'resistance_levels': resistance_levels,
        'signal_strength': signal_strength,
        'signal_reason': signal_reason,
        'nearest_support': nearest_support,
        'nearest_resistance': nearest_resistance
    }

def generate_5min_candle(index_name, chartink_symbol):
    """
    Called at each 5‐minute boundary. Builds a new candle from current_5min_data,
    appends to historical_data, recalculates indicators, potentially sends an order.
    """
    global current_5min_data, historical_data, current_position
    
    if index_name not in current_5min_data:
        logger.warning(f"No tick data for {index_name}, skipping 5-min candle.")
        return
    
    now = datetime.now(pytz.timezone('Asia/Kolkata'))
    minutes_past = now.minute % 5
    interval_end = now.replace(second=0, microsecond=0)
    interval_start = interval_end - timedelta(minutes=5)
    
    # Initialize historical if needed
    if index_name not in historical_data or historical_data[index_name].empty:
        df_hist = fetch_historical_data_chartink(chartink_symbol)
        historical_data[index_name] = df_hist
    
    # Build new candle dict
    odo = current_5min_data[index_name]
    new_candle = {
        'timestamp': now.strftime('%Y-%m-%d %H:%M:%S'),
        'interval_start': interval_start.strftime('%Y-%m-%d %H:%M:%S'),
        'interval_end': interval_end.strftime('%Y-%m-%d %H:%M:%S'),
        'open': odo['open'],
        'high': odo['high'],
        'low': odo['low'],
        'close': odo['close'],
        'volume': odo['volume']
    }
    # Append to historical_data DataFrame
    new_row = pd.DataFrame([{
        'open': odo['open'],
        'high': odo['high'],
        'low': odo['low'],
        'close': odo['close'],
        'volume': odo['volume'],
        'ema9': np.nan,
        'bb_upper': np.nan,
        'bb_middle': np.nan,
        'bb_lower': np.nan
    }], index=[pd.Timestamp(now)])
    
    hist_df = historical_data[index_name].copy()
    hist_df = pd.concat([hist_df, new_row])
    if len(hist_df) > 1000:
        hist_df = hist_df.tail(1000)
    hist_df = ensure_indicators(hist_df)
    historical_data[index_name] = hist_df
    
    # Generate trading signal with S/R analysis
    if len(hist_df) < STRATEGY_PARAMS['min_candles_history']:
        signal = "WAIT_FOR_DATA"
        sr_info = {}
        logger.info(f"Collecting data for {index_name}: {len(hist_df)}/{STRATEGY_PARAMS['min_candles_history']} candles.")
    else:
        if index_name not in current_position:
            current_position[index_name] = "FLAT"
        signal, sr_info = generate_trade_signal_with_sr(hist_df, current_position[index_name])
        
        # Enhanced logging with S/R info
        if sr_info.get('signal_reason'):
            logger.info(f"Signal reasons: {', '.join(sr_info['signal_reason'])}")
            logger.info(f"Signal strength: {sr_info.get('signal_strength', 0)}")

        # Log current S/R levels
        if sr_info.get('support_levels'):
            support_prices = [f"{s['price']:.2f}({s['touches']})" for s in sr_info['support_levels'][:3]]
            logger.info(f"Key supports: {', '.join(support_prices)}")

        if sr_info.get('resistance_levels'):
            resistance_prices = [f"{r['price']:.2f}({r['touches']})" for r in sr_info['resistance_levels'][:3]]
            logger.info(f"Key resistances: {', '.join(resistance_prices)}")
        
        if signal == "BUY" and current_position[index_name] != "LONG":
            logger.info(f"🟢 BUY SIGNAL for {index_name} — placing order.")
            if not TRADING_CONFIG['dry_run']:
                place_order(index_name, "BUY")
            current_position[index_name] = "LONG"
        elif signal == "SELL" and current_position[index_name] != "SHORT":
            logger.info(f"🔴 SELL SIGNAL for {index_name} — placing order.")
            if not TRADING_CONFIG['dry_run']:
                place_order(index_name, "SELL")
            current_position[index_name] = "SHORT"
    
    # Fill indicators & signal for CSV row
    latest = hist_df.iloc[-1]
    new_candle['ema9'] = latest.get('ema9', np.nan)
    new_candle['bb_upper'] = latest.get('bb_upper', np.nan)
    new_candle['bb_middle'] = latest.get('bb_middle', np.nan)
    new_candle['bb_lower'] = latest.get('bb_lower', np.nan)
    new_candle['signal'] = signal
    
    # Add S/R data to CSV
    new_candle['nearest_support'] = sr_info.get('nearest_support', {}).get('price', '') if sr_info.get('nearest_support') else ''
    new_candle['nearest_resistance'] = sr_info.get('nearest_resistance', {}).get('price', '') if sr_info.get('nearest_resistance') else ''
    new_candle['signal_strength'] = sr_info.get('signal_strength', 0)
    new_candle['signal_reasons'] = '; '.join(sr_info.get('signal_reason', []))
    
    # Write to CSV
    filename = create_csv_file(index_name)
    append_to_csv(filename, new_candle)
    
    # Reset current_5min_data for next candle
    last_close = current_5min_data[index_name]['close']
    current_5min_data[index_name] = {
        'open': last_close,
        'high': last_close,
        'low': last_close,
        'close': last_close,
        'volume': 0,
        'timestamp': now
    }
    
    # Log a prettified status block with S/R info
    try:
        ema9_val = new_candle['ema9'] if not pd.isna(new_candle['ema9']) else 0.0
        bb_upper_val = new_candle['bb_upper'] if not pd.isna(new_candle['bb_upper']) else 0.0
        bb_middle_val = new_candle['bb_middle'] if not pd.isna(new_candle['bb_middle']) else 0.0
        bb_lower_val = new_candle['bb_lower'] if not pd.isna(new_candle['bb_lower']) else 0.0
        
        nearest_sup = new_candle['nearest_support'] if new_candle['nearest_support'] else 'None'
        nearest_res = new_candle['nearest_resistance'] if new_candle['nearest_resistance'] else 'None'
        
        status_info = f"""
╔══════════════════════════════════════════════════════════════════╗
║ INDEX STATUS: {index_name:<47} ║
╠══════════════════════════════════════════════════════════════════╣
║ Time:          {now.strftime('%H:%M:%S'):<47} ║
║ Current Price: {last_close:>8.2f}{'':<37} ║
║ EMA9:          {ema9_val:>8.2f}{'':<37} ║
║ BB Upper:      {bb_upper_val:>8.2f}{'':<37} ║
║ BB Middle:     {bb_middle_val:>8.2f}{'':<37} ║
║ BB Lower:      {bb_lower_val:>8.2f}{'':<37} ║
║ Near Support:  {str(nearest_sup):<47} ║
║ Near Resist:   {str(nearest_res):<47} ║
║ Signal:        {signal:<47} ║
