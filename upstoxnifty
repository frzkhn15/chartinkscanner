def get_index_data(instrument_key, index_name):
    """
    Fetch the price data for a given index (Upstox quotes).
    """
    url = f"{BASE_URL}/market-quote/quotes"
    params = {"instrument_key": instrument_key}
    try:
        resp = requests.get(url, headers=HEADERS, params=params, timeout=10)
        resp.raise_for_status()
        payload = resp.json()
        data_dict = payload.get("data", {})
        if not data_dict:
            raise ValueError("No data found in response")
        first_entry = next(iter(data_dict.values()))
        last_price = first_entry.get("last_price")
        ohlc = first_entry.get("ohlc", {})
        open_price = ohlc.get("open", first_entry.get("open"))
        high_price = ohlc.get("high", first_entry.get("high"))
        low_price = ohlc.get("low", first_entry.get("low"))
        close_price = last_price
        timestamp = datetime.now(pytz.timezone('Asia/Kolkata'))
        return {
            "index": index_name,
            "timestamp": timestamp.strftime('%Y-%m-%d %H:%M:%S'),
            "open": open_price,
            "high": high_price,
            "low": low_price,
            "close": close_price,
            "last_price": last_price
        }
    except requests.exceptions.RequestException as e:
        logger.error(f"Network error fetching {index_name} data: {e}")
        return None
    except Exception as e:
        logger.error(f"Error fetching {index_name} data: {e}")
        return None

def is_market_open():
    """
    Check if the market is currently open (9:15 AM to 3:30 PM IST, Mon−Fri).
    """
    ist = pytz.timezone('Asia/Kolkata')
    now = datetime.now(ist)
    # Weekday: Mon=0, Sun=6
    if now.weekday() >= 7:  # Saturday=5, Sunday=6
        return False
    open_time = now.replace(hour=0, minute=0, second=0, microsecond=0)
    close_time = now.replace(hour=23, minute=50, second=0, microsecond=0)
    return open_time <= now <= close_time

