def get_next_interval(minute_interval=5):
    """
    Compute the next 5‐minute candle boundary and seconds until then.
    """
    now = datetime.now(pytz.timezone('Asia/Kolkata'))
    minutes_past = now.minute % minute_interval
    seconds_past = now.second
    seconds_to_next = ((minute_interval - minutes_past) * 60) - seconds_past
    next_interval = now + timedelta(seconds=seconds_to_next)
    return next_interval, seconds_to_next

