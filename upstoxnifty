║ Position:      {current_position.get(index_name, 'FLAT'):<47} ║
╚══════════════════════════════════════════════════════════════════╝
"""
        logger.info(status_info)
    except Exception as e:
        logger.error(f"Error formatting status block for {index_name}: {e}")
        logger.info(f"{index_name} — Signal: {signal}, Position: {current_position.get(index_name, 'FLAT')}")

def place_order(instrument_key, transaction_type, order_type="MARKET", quantity=1):
    """
    Place actual order via Upstox API when not in dry-run mode.
    """
    try:
        # Map index names to actual tradeable instrument keys
        instrument_mapping = {
            "Bank Nifty": "NSE_FO|BANKNIFTY",  # You'll need to specify the actual contract
            "Nifty 50": "NSE_FO|NIFTY"        # You'll need to specify the actual contract
        }
        
        # Get the tradeable instrument key
        tradeable_instrument = instrument_mapping.get(instrument_key, instrument_key)
        
        # Prepare order payload
        order_payload = {
            "quantity": quantity * TRADING_CONFIG["num_lots"],
            "product": TRADING_CONFIG["product"],
            "validity": "DAY",
            "price": TRADING_CONFIG["price"],
            "tag": "bank_nifty_strategy",
            "instrument_token": tradeable_instrument,
            "order_type": order_type,
            "transaction_type": transaction_type,
            "disclosed_quantity": 0,
            "trigger_price": TRADING_CONFIG["trigger_price"],
            "is_amo": False
        }
        
        # Remove None values
        order_payload = {k: v for k, v in order_payload.items() if v is not None}
        
        url = f"{BASE_URL}/order/place"
        
        for attempt in range(TRADING_CONFIG["max_retries"]):
            try:
                logger.info(f"Placing {transaction_type} order for {instrument_key} (attempt {attempt + 1})")
                response = requests.post(url, headers=HEADERS, json=order_payload, timeout=30)
                response.raise_for_status()
                
                result = response.json()
                if result.get("status") == "success":
                    order_id = result.get("data", {}).get("order_id")
                    logger.info(f"✅ Order placed successfully: {order_id}")
                    return {"status": "success", "data": {"order_id": order_id}}
                else:
                    logger.error(f"Order placement failed: {result}")
                    
            except requests.exceptions.RequestException as e:
                logger.error(f"Network error placing order (attempt {attempt + 1}): {e}")
                if attempt < TRADING_CONFIG["max_retries"] - 1:
                    time.sleep(TRADING_CONFIG["retry_delay"])
                    continue
                else:
                    return {"status": "error", "error": str(e)}
            except Exception as e:
                logger.error(f"Error placing order: {e}")
                return {"status": "error", "error": str(e)}
        
        return {"status": "error", "error": "Max retries exceeded"}
        
    except Exception as e:
        logger.error(f"Error in place_order function: {e}")
        return {"status": "error", "error": str(e)}

def collect_data_thread(indices, tick_interval=60):
    """
    Thread that runs continuously, collecting tick‐by‐tick data once per `tick_interval` seconds,
    building 5‐minute candles, and triggering generate_5min_candle at each interval.
    """
    global running, chartink_api
    
    logger.info(f"Starting data‐collection thread (tick every {tick_interval}s).")
    chartink_api = ChartinkAPI()
    
    # Preload historical data for each index
    for index in indices:
        sym = index.get("chartink_symbol")
        name = index["name"]
        if sym:
            logger.info(f"Initializing historical data for {name} ({sym})")
            historical_data[name] = fetch_historical_data_chartink(sym)
    
    while running:
        try:
            if not is_market_open():
                logger.info("Market is closed. Sleeping for 60s.")
                time.sleep(60)
                continue
            
            next_interval, secs_to_next = get_next_interval(5)
            logger.debug(f"Next 5‐min boundary @ {next_interval.strftime('%H:%M:%S')} ({secs_to_next}s away).")
            
            ticks_remaining = max(1, int(secs_to_next / tick_interval))
            for _ in range(ticks_remaining):
                if not running:
                    break
                for index in indices:
                    ik = index["instrument_key"]
                    name = index["name"]
                    tick = get_index_data(ik, name)
                    if tick:
                        process_tick_data(name, tick)
                        logger.info(f"{name} @ {tick['timestamp']}: Price {tick['last_price']:.2f}")
                time.sleep(tick_interval)
            
            # Build 5-minute candles now
            for index in indices:
                name = index["name"]
                sym = index.get("chartink_symbol")
                if sym:
                    generate_5min_candle(name, sym)
        except Exception as e:
            logger.error(f"Error in data‐collection thread: {e}")
            import traceback
            logger.error(traceback.format_exc())
            time.sleep(5)

def signal_handler(sig, frame):
    """
    Gracefully stop on Ctrl+C
    """
    global running
    logger.info("Stopping data collection...")
    running = False

