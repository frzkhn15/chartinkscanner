# ─── Chartink Data Extractor (real‐call) ────────────────────────────────────────────
#
# Adapted from workingchartinkhistorical.py. You must supply your own Chartink session
# cookies and headers here so that the POST requests to Chartink's OAPI actually work.

class ChartInkDataExtractor:
    def __init__(self):
        self.base_url = "https://chartink.com/oapi"
        self.session = requests.Session()
        self.lock = threading.Lock()
        
        # ── IMPORTANT: Update these headers & cookies with values from your Chartink browser session ──
        self.headers = {
            "accept": "application/json, text/plain, */*",
            "accept-language": "en-US,en;q=0.9",
            "content-type": "application/x-www-form-urlencoded",
            "origin": "https://chartink.com",
            "referer": "https://chartink.com/stocks-new",
            # Use a valid User-Agent from a browser where you're logged into Chartink
            "user-agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko)"
        }
        
        # ── IMPORTANT: Replace these with your own Chartink cookies (obtained via browser dev tools) ──
        self.cookies = {
            "_ga": "GA1.2.1533223166.1742236648",
            "_cc_id": "c6ecc787c8c1803e4a38a7f85b8adbc2",
            "XSRF-TOKEN": "",
            "ci_session": ""
        }
        # Chartink expects an XSRF‐token header matching the cookie:
        self.headers["x-xsrf-token"] = self.cookies["XSRF-TOKEN"]
    
    def fetch_single_column(self, symbol, indicator_name, alias, timeframe="5 minutes", limit=500):
        """
        Fetch a single column/indicator via Chartink's oapi endpoint:
          - indicator_name: e.g. "open", "high", "low", "close", "volume"
          - alias: the name you want in the DataFrame (e.g. "open", "high", etc.)
        Returns a pandas.DataFrame indexed by timestamp with one column [alias].
        """
        try:
            query = f"select {indicator_name} as '{alias}' where symbol='{symbol}'"
            payload = {
                "query": query,
                "use_live": "1",
                "limit": str(limit),
                "size": str(limit),
                "end_time": "-1",
                "timeframe": timeframe,
                "symbol": symbol,
                "scan_link": "null"
            }
            
            logger.info(f"Fetching column '{indicator_name}' -> '{alias}' for {symbol}")
            response = self.session.post(
                self.base_url,
                headers=self.headers,
                cookies=self.cookies,
                data=payload,
                timeout=30
            )
            response.raise_for_status()
            data = response.json()
            
            if "metaData" in data and "groupData" in data:
                return self._parse_single_column_response(data, alias)
            else:
                logger.error(f"Unexpected API response for {indicator_name}: {data}")
                return None
                
        except Exception as e:
            logger.error(f"Error fetching {indicator_name} for {symbol}: {e}")
            return None
    
    def _parse_single_column_response(self, data, expected_alias):
        """
        Parse Chartink's single‐column response. Returns a DataFrame with:
            index = timestamps (pandas.DatetimeIndex)
            column = [expected_alias]
        """
        try:
            meta_data = data["metaData"][0]
            group_data = data["groupData"][0]
            trade_times = meta_data["tradeTimes"]
            results = group_data["results"][0]
            
            available_keys = list(results.keys())
            if not available_keys:
                logger.error(f"No data keys found for '{expected_alias}'")
                return None
            
            actual_key = available_keys[0]
            values = results[actual_key]
            
            if not values or len(values) == 0:
                logger.warning(f"No values returned for '{expected_alias}'")
                return None
            
            # Build DataFrame
            min_length = min(len(trade_times), len(values))
            df = pd.DataFrame({
                expected_alias: values[:min_length],
                "timestamp": pd.to_datetime(trade_times[:min_length], unit="ms")
            })
            df.set_index("timestamp", inplace=True)
            df = df.sort_index()
            
            logger.info(f"✓ Fetched '{expected_alias}': {len(df)} rows")
            return df
        except Exception as e:
            logger.error(f"Error parsing response for '{expected_alias}': {e}")
            return None
    
    def fetch_multiple_columns_sequential(self, symbol, columns_config, timeframe="5 minutes", limit=500):
        """
        Fetch multiple columns (OHLCV) one after another. 
        columns_config: list of tuples [(indicator_name, alias), ...]
        Returns a list of DataFrames (one per alias). You will need to combine them afterward.
        """
        dataframes = []
        for indicator_name, alias in columns_config:
            df = self.fetch_single_column(symbol, indicator_name, alias, timeframe, limit)
            if df is not None:
                dataframes.append(df)
            time.sleep(0.5)  # small delay to respect rate limits
        return dataframes
    
    def combine_dataframes(self, dfs):
        """
        Take a list of single‐column DataFrames (all indexed by timestamp) 
        and join them into one DataFrame. Returns combined DataFrame.
        """
        if not dfs:
            logger.error("No DataFrames to combine")
            return None
        
        combined = dfs[0].copy()
        for df in dfs[1:]:
            combined = combined.join(df, how="outer")
        
        combined.sort_index(inplace=True)
        combined.dropna(how="all", inplace=True)
        logger.info(f"Combined DataFrame: {combined.shape[0]} rows, {combined.shape[1]} cols")
        return combined


# ─── ChartinkAPI (wrapper) ────────────────────────────────────────────────────────

class ChartinkAPI:
    """
    Wrapper around ChartInkDataExtractor that returns raw lists of dicts for historical OHLCV.
    The final.py logic will then calculate indicators locally.
    """
    def __init__(self):
        self.extractor = ChartInkDataExtractor()
    
    def fetch_data(self, symbol, timeframe="5 minutes", query=None, size=500, limit=500, use_live=1):
        """
        Fetch raw OHLCV from Chartink for the given symbol.
        Ignores 'query' parameter here (we only want open,high,low,close,volume).
        Returns:
            { 'success': True, 'data': [ { 'open': ..., 'high': ..., 'low': ..., 'close': ..., 'volume': ... }, ... ] }
        or
            { 'success': False, 'error': '...' }
        """
        try:
            # Define the five OHLCV columns:
            columns_config = [
                ("open", "open"),
                ("high", "high"),
                ("low", "low"),
                ("close", "close"),
                ("volume", "volume")
            ]
            
            dfs = self.extractor.fetch_multiple_columns_sequential(
                symbol=symbol,
                columns_config=columns_config,
                timeframe=timeframe,
                limit=size
            )
            if not dfs or len(dfs) < len(columns_config):
                return { 'success': False, 'error': "Failed to fetch all OHLCV columns", 'data': [] }
            
            combined_df = self.extractor.combine_dataframes(dfs)  # DataFrame indexed by timestamp
            if combined_df is None or combined_df.empty:
                return { 'success': False, 'error': "No data returned from Chartink", 'data': [] }
            
            # Convert to list of dicts (oldest→newest). We only need raw open,high,low,close,volume.
            records = []
            for _, row in combined_df.iterrows():
                records.append({
                    'open': float(row['open']),
                    'high': float(row['high']),
                    'low': float(row['low']),
                    'close': float(row['close']),
                    'volume': float(row['volume'])
                })
            
            return { 'success': True, 'data': records }
        except Exception as e:
            logger.error(f"Error in ChartinkAPI.fetch_data: {e}")
            return { 'success': False, 'error': str(e), 'data': [] }


